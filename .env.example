# AI Companion — 环境变量示例（复制为 .env 使用）
# 监听地址（默认仅本机）
COMPANION_HOST=127.0.0.1
COMPANION_PORT=8787
# 数据目录（SQLite + 媒体 + 主密钥文件）
COMPANION_DATA_DIR=./data
# 主密钥来源：file（默认，data/keys/master.key）| env
COMPANION_KEY_PROVIDER=file
# 当 COMPANION_KEY_PROVIDER=env 时使用（32 字节 hex 或 base64）
COMPANION_MASTER_KEY=
# 日志级别：trace|debug|info|warn|error
COMPANION_LOG_LEVEL=info
