{
  "name": "@companion/backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=../.env src/app/main.ts",
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --env-file-if-exists=../.env --test --test-concurrency=4 --test-timeout=60000 \"test/**/*.test.ts\"",
    "guard": "node --test \"test/arch/*.test.ts\"",
    "build": "tsc -p tsconfig.json --noEmit",
    "smoke": "node scripts/phase2-smoke.ts",
    "smoke:phase3": "node scripts/phase3-smoke.ts",
    "smoke:phase4": "node scripts/phase4-smoke.ts",
    "smoke:phase45b": "node scripts/phase45b-smoke.ts",
    "smoke:phase45c1": "node scripts/phase45c1-smoke.ts",
    "smoke:phase45c2": "node scripts/phase45c2-smoke.ts",
    "smoke:phase45c3": "node scripts/phase45c3-smoke.ts",
    "smoke:phase45d1": "node scripts/phase45d1-smoke.ts",
    "smoke:phase45d2": "node scripts/phase45d2-smoke.ts",
    "smoke:phase45d3": "node scripts/phase45d3-smoke.ts",
    "smoke:phase45d4": "node scripts/phase45d4-smoke.ts",
    "smoke:phase45e": "node scripts/phase45e-smoke.ts",
    "media:audit": "node scripts/media-audit.ts"
  },
  "dependencies": {
    "fastify": "^5.2.1",
    "silk-wasm": "^3.7.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^5.8.2"
  }
}
